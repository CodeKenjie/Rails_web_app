<h1 class="text-4xl font-bold p-5 w-fit">Products</h1>
<% if authenticated? %>
  <div class = "flex items-center text-xl font-semibold p-2 px-5">
    <%= 
      link_to "New Product",
      new_product_path,
      class: "bg-blue-500 hover:bg-blue-600 rounded-xl p-2 text-white"
    %>
  </div>
<% end %>
<div class="flex-1 flex justify-center">
  <ul class="flex-cols p-5 w-fit items-self-center text-xl flex-cols bg-white rounded-xl shadow">
    <% @products.each do |product| %>
      <li class="flex w-full p-2 items-center border-1 border-gray-300 rounded-xl">
        <%= link_to product.name, product %>
      </li>
    <% end %>
  </ul>
</div>
