<div class="h-screen flex flex-col gap-5 p-5 items-center">
  <%= 
    link_to products_path,
    class: "w-[3em] h-fit self-start text-center bg-gray-500 hover:bg-gray-600 rounded-xl p-1 text-white" do %>
    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"> <path d="M8.60112 16.5308C8.89426 16.8234 9.36913 16.823 9.66178 16.5299C9.95442 16.2367 9.95402 15.7619 9.66088 15.4692L8.60112 16.5308ZM5.52988 11.3452C5.23674 11.0526 4.76187 11.053 4.46922 11.3461C4.17658 11.6393 4.17698 12.1141 4.47012 12.4068L5.52988 11.3452ZM4.48682 11.3291C4.18475 11.6125 4.16964 12.0871 4.45306 12.3892C4.73648 12.6912 5.21111 12.7064 5.51318 12.4229L4.48682 11.3291ZM9.64418 8.54694C9.94625 8.26352 9.96136 7.78889 9.67794 7.48682C9.39452 7.18475 8.91989 7.16964 8.61782 7.45306L9.64418 8.54694ZM5 11.126C4.58579 11.126 4.25 11.4618 4.25 11.876C4.25 12.2902 4.58579 12.626 5 12.626V11.126ZM15.37 11.876L15.3723 11.126H15.37V11.876ZM17.9326 10.8234L18.4614 11.3553V11.3553L17.9326 10.8234ZM19.75 8.26907C19.7511 7.85486 19.4163 7.51815 19.0021 7.517C18.5879 7.51586 18.2511 7.85072 18.25 8.26493L19.75 8.26907ZM9.66088 15.4692L5.52988 11.3452L4.47012 12.4068L8.60112 16.5308L9.66088 15.4692ZM5.51318 12.4229L9.64418 8.54694L8.61782 7.45306L4.48682 11.3291L5.51318 12.4229ZM5 12.626H15.37V11.126H5V12.626ZM15.3677 12.626C16.5267 12.6295 17.6395 12.1724 18.4614 11.3553L17.4038 10.2916C16.8641 10.8282 16.1333 11.1283 15.3723 11.126L15.3677 12.626ZM18.4614 11.3553C19.2833 10.5382 19.7468 9.42801 19.75 8.26907L18.25 8.26493C18.2479 9.02598 17.9435 9.755 17.4038 10.2916L18.4614 11.3553Z" fill="currentColor"></path> </g></svg>
  <% end %>
  <% if @product.featured_image.attached? %>
    <%= 
      image_tag @product.featured_image,
      class: "h-[50em] w-[45em] rounded-lg"
    %>
  <% end %>
  <% cache @product do %>
    <h1 class="text-4xl"><%= @product.name.capitalize %></h1>
    <%= @product.description %>
  <% end %>
  <% if authenticated? %>
    <%= form_with model: [@product, Comment.new], class: "flex flex-col gap-2 w-full max-w-[50em]" do |form|%>
      <%= 
        form.text_field :title,
        required: true,
        autofocus: true,
        placeholder: "Title",
        class: "text-xl border-1 border-gray-300 p-3 w-full rounded-xl"
      %>
      <%= 
        form.text_area :body,
        placeholder: "How was the product?",
        class: "w-full text-xl p-2 resize-none border-1 border-gray-300 rounded-lg bg-white"
      %>
      <div class="w-fit h-fit text-xl text-center font-bold bg-blue-500 hover:bg-blue-600 rounded-xl p-2 text-white">
        <%= form.submit "Submit" %>
      </div>
    <% end %>
  <% end %>
  <div class="flex flex-col w-full max-w-[60em] p-5 bg-white rounded-xl shadow">
    <h1 class="text-3xl opacity-50 font-bold">Comments</h1>
    <ul class="flex flex-col flex-1 overflow-auto gap-2">
      <% @product.comments.each do |comment|%>
        <li class="border-1 border-gray-300 rounded-xl shadow p-2">
          <div class="flex flex-wrap gap-2 text-2xl justify-between items-center">
            <%= comment.user.email_address %>
            <%= comment.user.is_seller ? "Seller" : "Buyer" %>
            <% if Current.user&.email_address == comment.user.email_address%>
              <%= 
                button_to "Delete",
                product_comments_path(@product, comment),
                method: :delete,
                data: {turbo_confirm: "are you sure you want to delete #{comment.title}"},
                class: "w-[4em] h-fit text-md text-center bg-blue-500 hover:bg-blue-600 rounded-xl p-2 text-white"
              %>
            <% end %>
          </div>
          <div class="flex flex-col p-2">
            <span class="text-xl font-bold px-2 bg-gray-200">
              <%= comment.title %>
            </span>
            <span class="text-xl px-2">
              <%= comment.body %>
            </span>
          </div>
        </li>
      <% end %>
    <ul>
  </div>
  <div class="flex gap-2">
    <% if Current.user&.is_seller %>
      <%= 
        link_to "Edit",
        edit_product_path(@product),
        class: "w-[4em] h-fit text-center bg-blue-500 hover:bg-blue-600 rounded-xl p-2 text-white"
      %>
      <%= 
        button_to "Delete",
        @product,
        method: :delete,
        data: { turbo_confirm: "are you sure you want to delete #{@product.name.capitalize}" },
        class: "w-[4em] h-fit text-center bg-blue-500 hover:bg-blue-600 rounded-xl p-2 text-white"
      %>
    <% end %>
  <div>
</div>
