<%= form_with model: @product do |form| %>
  <div>
    <%= form.label :featured_image, style: "display_block" %>
    <%= form.file_field :featured_image, accept: "image/*" %>
  </div>

  <div>
    <%= form.label :name %>
    <%= form.text_field :name %>
    <%= form.rich_textarea :description %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
