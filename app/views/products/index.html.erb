<h1 class="text-4xl font-bold p-5 w-fit">Products</h1>
<% if Current.user&.is_seller %>
  <div class = "flex items-center text-xl font-semibold p-2 px-5">
    <%= 
      link_to "New Product",
      new_product_path,
      class: "bg-blue-500 hover:bg-blue-600 rounded-xl p-2 text-white"
    %>
  </div>
<% end %>
<ul class="h-[73em] min-h-0 flex flex-col self-center p-5 w-full max-w-[100em] h- bg-white rounded-xl overflow-y-auto shadow gap-2">
  <% @products.each do |product| %>
    <li class="flex flex-wrap border-1 border-gray-300 rounded-xl w-full p-2 gap-5">
      <% if product.featured_image.attached? %>
        <%= image_tag product.featured_image, class: "h-60 w-50 object-cover" %>
      <% end %>
      <div class="flex-1 flex flex-col">
        <p class="flex-1 text-2xl font-semibold w-full" >
          <%= product.name.capitalize%>
        </p>
        <div class="flex w-full h-fit gap-2 justify-end">
          <%= 
            link_to "Show",
            product,
            class: "w-[4em] text-center bg-blue-500 hover:bg-blue-600 rounded-xl p-2 text-white"
          %>
          <% if Current.user&.is_seller %>
            <%= 
              link_to "Edit",
              edit_product_path(product),
              class: "w-[4em] text-center bg-blue-500 hover:bg-blue-600 rounded-xl p-2 text-white"
            %>
            <%= 
              button_to "Delete",
              product,
              method: :delete,
              data: { turbo_confirm: "are you sure you want to delete #{product.name.capitalize}" },
              class: "w-[4em] text-center bg-blue-500 hover:bg-blue-600 rounded-xl p-2 text-white"
            %>
          <% end %>
        </div>
      </div>
    </li>
  <% end %>
</ul>
